        "import re\n",
        "import torch\n",
        "from transformers import AutoTokenizer, AutoModelForCausalLM\n",
        "\n",
        "# =========================\n",
        "# 1) Cleaning utilities\n",
        "# =========================\n",
        "STOP_PATTERNS = [\n",
        "    r\"\\n\\s*Human\\s*:\", r\"\\n\\s*User\\s*:\", r\"\\n\\s*Assistant\\s*:\",\n",
        "    r\"\\bHuman\\s*:\", r\"\\bUser\\s*:\", r\"\\bAssistant\\s*:\",\n",
        "    r\"\\bYou are an AI assistant\\b\",\n",
        "    r\"<\\|im_start\\|>\", r\"<\\|im_end\\|>\",\n",
        "    r\"\\n###\", r\"\\b###\\b\",\n",
        "    r\"\\n\\s*Context\\s*:\", r\"\\bContext\\s*:\",\n",
        "    r\"\\n\\s*Question\\s*:\", r\"\\bQuestion\\s*:\",\n",
        "]\n",
        "STOP_REGEX = re.compile(\"|\".join(STOP_PATTERNS), flags=re.IGNORECASE)\n",
        "\n",
        "HTML_TAG_RE = re.compile(r\"<[^>]+>\")\n",
        "PREFACE_RE = re.compile(\n",
        "    r\"^(sure!?|of course!?|here'?s.*?:|here is.*?:|according to.*?:)\\s*\",\n",
        "    flags=re.IGNORECASE,\n",
        ")\n",
        "\n",
        "def strip_after_stop(text: str) -> str:\n",
        "    if not text:\n",
        "        return \"\"\n",
        "    m = STOP_REGEX.search(text)\n",
        "    return (text[:m.start()] if m else text).strip()\n",
        "\n",
        "def cleanup_preface(text: str) -> str:\n",
        "    text = (text or \"\").strip()\n",
        "    while True:\n",
        "        new = PREFACE_RE.sub(\"\", text).strip()\n",
        "        if new == text:\n",
        "            return text\n",
        "        text = new\n",
        "\n",
        "def normalize_whitespace(text: str) -> str:\n",
        "    return re.sub(r\"\\s+\", \" \", (text or \"\")).strip()\n",
        "\n",
        "def clean_answer(text: str, max_chars: int = 420) -> str:\n",
        "    text = strip_after_stop(text)\n",
        "    text = cleanup_preface(text)\n",
        "\n",
        "    text = HTML_TAG_RE.sub(\" \", text)\n",
        "    text = text.replace(\"**\", \"\").replace(\"__\", \"\").replace(\"`\", \"\")\n",
        "    text = normalize_whitespace(text)\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"^(final\\s*answer\\s*:\\s*|answer\\s*:\\s*)\",\n",
        "        \"\",\n",
        "        text,\n",
        "        flags=re.IGNORECASE,\n",
        "    ).strip()\n",
        "\n",
        "    text = text.splitlines()[0].strip()\n",
        "    text = normalize_whitespace(text)\n",
        "\n",
        "    if len(text) <= max_chars:\n",
        "        return text\n",
        "\n",
        "    window = text[:max_chars]\n",
        "\n",
        "    cut = window.rfind(\". \")\n",
        "    if cut != -1:\n",
        "        return window[:cut + 1].strip()\n",
        "\n",
        "    for sep in [\"; \", \", \"]:\n",
        "        cut = window.rfind(sep)\n",
        "        if cut != -1 and cut > 30:\n",
        "            return window[:cut + 1].strip()\n",
        "\n",
        "    cut = window.rfind(\" \")\n",
        "    if cut != -1 and cut > 30:\n",
        "        return window[:cut].strip()\n",
        "\n",
        "    trimmed = re.sub(r\"\\w+$\", \"\", window).strip()\n",
        "    return trimmed if trimmed else window.strip()\n",
        "\n",
        "\n",
        "# =========================\n",
        "# 2) Model loading\n",
        "# =========================\n",
        "DTYPE = torch.float16 if torch.cuda.is_available() else torch.float32\n",
        "DEVICE_MAP = \"auto\" if torch.cuda.is_available() else None\n",
        "\n",
        "QWEN_NAME = \"Qwen/Qwen2.5-1.5B-Instruct\"\n",
        "GEMMA_NAME = \"google/gemma-2b-it\"\n",
        "\n",
        "qwen_tokenizer = AutoTokenizer.from_pretrained(QWEN_NAME)\n",
        "qwen_model = AutoModelForCausalLM.from_pretrained(\n",
        "    QWEN_NAME,\n",
        "    torch_dtype=DTYPE,\n",
        "    device_map=DEVICE_MAP,\n",
        ")\n",
        "qwen_model.eval()\n",
        "\n",
        "HF_TOKEN = \"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\"\n",
        "\n",
        "gemma_tokenizer = AutoTokenizer.from_pretrained(\n",
        "    GEMMA_NAME,\n",
        "    token=HF_TOKEN,\n",
        ")\n",
        "gemma_model = AutoModelForCausalLM.from_pretrained(\n",
        "    GEMMA_NAME,\n",
        "    token=HF_TOKEN,\n",
        "    torch_dtype=DTYPE,\n",
        "    device_map=DEVICE_MAP,\n",
        ")\n",
        "gemma_model.eval()\n",
        "\n",
        "if qwen_tokenizer.pad_token_id is None:\n",
        "    qwen_tokenizer.pad_token = qwen_tokenizer.eos_token\n",
        "\n",
        "if gemma_tokenizer.pad_token_id is None:\n",
        "    gemma_tokenizer.pad_token = gemma_tokenizer.eos_token\n",
        "\n",
        "\n",
        "# =========================\n",
        "# 3) Shared generation helper\n",
        "# =========================\n",
        "@torch.inference_mode()\n",
        "def generate_with_model(\n",
        "    prompt: str,\n",
        "    tokenizer,\n",
        "    model,\n",
        "    max_new_tokens: int = 160,\n",
        "    max_chars: int = 420,\n",
        "    extra_eos_token_ids: list[int] | None = None,\n",
        ") -> str:\n",
        "    rendered_prompt = prompt\n",
        "\n",
        "    if hasattr(tokenizer, \"apply_chat_template\"):\n",
        "        messages = [{\"role\": \"user\", \"content\": prompt}]\n",
        "        rendered_prompt = tokenizer.apply_chat_template(\n",
        "            messages,\n",
        "            tokenize=False,\n",
        "            add_generation_prompt=True,\n",
        "        )\n",
        "\n",
        "    inputs = tokenizer(rendered_prompt, return_tensors=\"pt\", truncation=True)\n",
        "\n",
        "    if torch.cuda.is_available():\n",
        "        inputs = {k: v.to(model.device) for k, v in inputs.items()}\n",
        "\n",
        "    prompt_len = inputs[\"input_ids\"].shape[1]\n",
        "\n",
        "    eos_ids = tokenizer.eos_token_id\n",
        "    if extra_eos_token_ids:\n",
        "        eos_ids = [tokenizer.eos_token_id, *extra_eos_token_ids]\n",
        "\n",
        "    outputs = model.generate(\n",
        "        **inputs,\n",
        "        max_new_tokens=max_new_tokens,\n",
        "        do_sample=False,\n",
        "        eos_token_id=eos_ids,\n",
        "        pad_token_id=tokenizer.pad_token_id,\n",
        "        repetition_penalty=1.05,\n",
        "    )\n",
        "\n",
        "    raw = tokenizer.decode(outputs[0][prompt_len:], skip_special_tokens=True)\n",
        "    return clean_answer(raw, max_chars=max_chars)\n",
        "\n",
        "\n",
        "@torch.inference_mode()\n",
        "def generate_qwen(prompt: str, max_new_tokens: int = 160) -> str:\n",
        "    extra_eos_ids = []\n",
        "\n",
        "    try:\n",
        "        im_end_id = qwen_tokenizer.convert_tokens_to_ids(\"<|im_end|>\")\n",
        "        if im_end_id is not None and im_end_id != qwen_tokenizer.unk_token_id:\n",
        "            extra_eos_ids.append(im_end_id)\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "    return generate_with_model(\n",
        "        prompt=prompt,\n",
        "        tokenizer=qwen_tokenizer,\n",
        "        model=qwen_model,\n",
        "        max_new_tokens=max_new_tokens,\n",
        "        max_chars=420,\n",
        "        extra_eos_token_ids=extra_eos_ids or None,\n",
        "    )\n",
        "\n",
        "\n",
        "@torch.inference_mode()\n",
        "def generate_gemma(prompt: str, max_new_tokens: int = 160) -> str:\n",
        "    return generate_with_model(\n",
        "        prompt=prompt,\n",
        "        tokenizer=gemma_tokenizer,\n",
        "        model=gemma_model,\n",
        "        max_new_tokens=max_new_tokens,\n",
        "        max_chars=420,\n",
        "    )\n",
        "\n",
        "\n",
        "# =========================\n",
        "# 4) Unified ask_chatbot\n",
        "# =========================\n",
        "def ask_chatbot(\n",
        "    question: str,\n",
        "    model_name: str = \"qwen\",\n",
        "    top_k: int = 20,\n",
        "    keep: int = 4,\n",
        "    max_new_tokens: int = 160,\n",
        "):\n",
        "    ctx = retrieve_relevant_chunks(question, top_k=top_k)\n",
        "    ctx = keyword_gate(question, ctx, keep=keep)\n",
        "\n",
        "    prompt = build_prompt(ctx, question, model_name=model_name)\n",
        "\n",
        "    generators = {\n",
        "        \"qwen\": generate_qwen,\n",
        "        \"gemma\": generate_gemma,\n",
        "    }\n",
        "\n",
        "    if model_name not in generators:\n",
        "        raise ValueError(\"model_name must be 'qwen' or 'gemma'\")\n",
        "\n",
        "    ans = generators[model_name](prompt, max_new_tokens=max_new_tokens)\n",
        "\n",
        "    pages_used = sorted({c.get(\"page\") for c in ctx if c.get(\"page\") is not None})\n",
        "    return {\n",
        "        \"answer\": ans,\n",
        "        \"contexts\": ctx,\n",
        "        \"pages\": pages_used,\n",
        "        \"prompt\": prompt,\n",
        "    }"
      ]
    },
