      "source": [
        "from google.colab import drive\n",
        "import os, json, platform, subprocess, shutil\n",
        "from datetime import datetime\n",
        "\n",
        "drive.mount(\"/content/drive\", force_remount=False)\n",
        "\n",
        "RUN_ID = datetime.now().strftime(\"AI3_project_%Y%m%d_%H%M%S\")\n",
        "OUT_DIR = f\"/content/drive/MyDrive/Colab Notebooks/AI3 Project/{RUN_ID}\"\n",
        "\n",
        "RESULTS_DIR = os.path.join(OUT_DIR, \"results\")\n",
        "PLOTS_DIR   = os.path.join(OUT_DIR, \"plots\")\n",
        "LOGS_DIR    = os.path.join(OUT_DIR, \"logs\")\n",
        "WEIGHTS_DIR = os.path.join(OUT_DIR, \"weights\")\n",
        "INDEX_DIR   = os.path.join(OUT_DIR, \"indexes\")\n",
        "NB_DIR      = os.path.join(OUT_DIR, \"notebook\")\n",
        "\n",
        "for d in [RESULTS_DIR, PLOTS_DIR, LOGS_DIR, WEIGHTS_DIR, INDEX_DIR, NB_DIR]:\n",
        "    os.makedirs(d, exist_ok=True)\n",
        "\n",
        "\n",
        "df_qwen.to_csv(os.path.join(RESULTS_DIR, \"df_qwen.csv\"), index=False)\n",
        "df_gemma.to_csv(os.path.join(RESULTS_DIR, \"df_gemma.csv\"), index=False)\n",
        "df_all.to_csv(os.path.join(RESULTS_DIR, \"df_all.csv\"), index=False)\n",
        "\n",
        "summary_df.to_csv(os.path.join(RESULTS_DIR, \"summary_df.csv\"), index=False)\n",
        "mean_metrics.to_csv(os.path.join(RESULTS_DIR, \"mean_metrics.csv\"), index=False)\n",
        "counts.reset_index().to_csv(os.path.join(RESULTS_DIR, \"failure_counts.csv\"), index=False)\n",
        "\n",
        "# ---- Export qualitative worst examples ----\n",
        "worst_qwen = show_worst(df_all, \"qwen\", n=5)\n",
        "worst_gemma = show_worst(df_all, \"gemma\", n=5)\n",
        "worst_qwen.to_csv(os.path.join(RESULTS_DIR, \"worst_qwen.csv\"), index=False)\n",
        "worst_gemma.to_csv(os.path.join(RESULTS_DIR, \"worst_gemma.csv\"), index=False)\n",
        "\n",
        "print(\"Saved CSV results to:\", RESULTS_DIR)\n",
        "\n",
        "# ---- Save plots: easiest approach is to re-generate and save them ----\n",
        "metrics = [\"recall@k\", \"precision@k\", \"token_f1\", \"numeric_recall\", \"unit_recall\"]\n",
        "x = range(len(metrics))\n",
        "\n",
        "qwen_vals = mean_metrics[mean_metrics[\"model\"]==\"qwen\"][metrics].values[0]\n",
        "gemma_vals = mean_metrics[mean_metrics[\"model\"]==\"gemma\"][metrics].values[0]\n",
        "\n",
        "# Plot 1: mean metrics\n",
        "fig, ax = plt.subplots(figsize=(10,4))\n",
        "ax.bar([i-0.2 for i in x], qwen_vals, width=0.4, label=\"Qwen\")\n",
        "ax.bar([i+0.2 for i in x], gemma_vals, width=0.4, label=\"Gemma\")\n",
        "ax.set_xticks(list(x))\n",
        "ax.set_xticklabels(metrics, rotation=30, ha=\"right\")\n",
        "ax.set_ylim(0, 1.05)\n",
        "ax.set_ylabel(\"Mean score\")\n",
        "ax.set_title(\"Mean Evaluation Metrics (Gemma vs Qwen)\")\n",
        "ax.legend()\n",
        "fig.tight_layout()\n",
        "fig.savefig(os.path.join(PLOTS_DIR, \"mean_metrics_bar.png\"), dpi=180, bbox_inches=\"tight\")\n",
        "plt.close(fig)\n",
        "\n",
        "# Plot 2: token f1 per question\n",
        "fig, ax = plt.subplots(figsize=(10,4))\n",
        "for m in [\"qwen\", \"gemma\"]:\n",
        "    d = df_all[df_all[\"model\"] == m].sort_values(\"idx\")\n",
        "    ax.plot(d[\"idx\"], d[\"token_f1\"], marker=\"o\", label=m)\n",
        "ax.set_ylim(0, 1.05)\n",
        "ax.set_xlabel(\"Question index\")\n",
        "ax.set_ylabel(\"Token F1\")\n",
        "ax.set_title(\"Token F1 per Question (Gemma vs Qwen)\")\n",
        "ax.legend()\n",
        "fig.tight_layout()\n",
        "fig.savefig(os.path.join(PLOTS_DIR, \"token_f1_per_question.png\"), dpi=180, bbox_inches=\"tight\")\n",
        "plt.close(fig)\n",
        "\n",
        "# Plot 3: failure breakdown stacked bar\n",
        "fig, ax = plt.subplots(figsize=(6,4))\n",
        "bottom = None\n",
        "for col in counts.columns:\n",
        "    vals = counts[col].values\n",
        "    if bottom is None:\n",
        "        ax.bar(counts.index.astype(str), vals, label=col)\n",
        "        bottom = vals\n",
        "    else:\n",
        "        ax.bar(counts.index.astype(str), vals, bottom=bottom, label=col)\n",
        "        bottom = bottom + vals\n",
        "ax.set_ylabel(\"Number of questions\")\n",
        "ax.set_title(f\"Failure Breakdown (Token F1 threshold = {FAIL_F1_THRESH})\")\n",
        "ax.legend()\n",
        "fig.tight_layout()\n",
        "fig.savefig(os.path.join(PLOTS_DIR, \"failure_breakdown.png\"), dpi=180, bbox_inches=\"tight\")\n",
        "plt.close(fig)\n",
        "\n",
        "\n",
        "# ---- logs ----\n",
        "env_info = {\"python\": platform.python_version(), \"platform\": platform.platform()}\n",
        "try:\n",
        "    import torch, transformers\n",
        "    env_info[\"torch\"] = torch.__version__\n",
        "    env_info[\"transformers\"] = transformers.__version__\n",
        "    env_info[\"cuda_available\"] = torch.cuda.is_available()\n",
        "    if torch.cuda.is_available():\n",
        "        env_info[\"gpu_name\"] = torch.cuda.get_device_name(0)\n",
        "except Exception as e:\n",
        "    env_info[\"env_error\"] = str(e)\n",
        "\n",
        "with open(os.path.join(LOGS_DIR, \"env_info.json\"), \"w\") as f:\n",
        "    json.dump(env_info, f, indent=2)\n",
        "\n",
        "with open(os.path.join(LOGS_DIR, \"requirements.txt\"), \"w\") as f:\n",
        "    subprocess.run([\"bash\", \"-lc\", \"pip freeze\"], stdout=f, check=False)\n",
        "\n",
        "# ---- weights note ----\n",
        "qwen_name = globals().get(\"QWEN_NAME\", \"Qwen model id not captured\")\n",
        "gemma_name = globals().get(\"GEMMA_NAME\", \"Gemma model id not captured\")\n",
        "with open(os.path.join(WEIGHTS_DIR, \"README.md\"), \"w\") as f:\n",
        "    f.write(\n",
        "        f\"# Model weights\\n\\n\"\n",
        "        f\"This notebook uses base Hugging Face models downloaded at runtime.\\n\\n\"\n",
        "        f\"- Qwen: {qwen_name}\\n\"\n",
        "        f\"- Gemma: {gemma_name}\\n\\n\"\n",
        "        f\"No fine-tuned weights were produced unless adapter training (LoRA/PEFT) was added.\\n\"\n",
        "    )\n",
        "\n",
        "# ---- indexes (RAG artifacts) ----\n",
        "try:\n",
        "    import numpy as np\n",
        "    if \"embeddings\" in globals():\n",
        "        np.save(os.path.join(INDEX_DIR, \"embeddings.npy\"), embeddings)\n",
        "except Exception as e:\n",
        "    with open(os.path.join(INDEX_DIR, \"embeddings_ERROR.txt\"), \"w\") as f:\n",
        "        f.write(str(e))\n",
        "\n",
        "try:\n",
        "    import faiss\n",
        "    if \"index\" in globals():\n",
        "        faiss.write_index(index, os.path.join(INDEX_DIR, \"faiss.index\"))\n",
        "except Exception as e:\n",
        "    with open(os.path.join(INDEX_DIR, \"faiss_ERROR.txt\"), \"w\") as f:\n",
        "        f.write(str(e))\n",
        "\n",
        "try:\n",
        "    for candidate in os.listdir(\"/content\"):\n",
        "        if candidate.endswith(\".ipynb\"):\n",
        "            shutil.copy2(os.path.join(\"/content\", candidate),\n",
        "                         os.path.join(NB_DIR, candidate))\n",
        "except Exception as e:\n",
        "    with open(os.path.join(NB_DIR, \"NOTE.txt\"), \"w\") as f:\n",
        "        f.write(\"Could not auto-copy notebook from /content. You can download the .ipynb and place it here.\\n\" + str(e))\n",
        "\n",
        "# ---- top-level README ----\n",
        "with open(os.path.join(OUT_DIR, \"README.md\"), \"w\") as f:\n",
        "    f.write(\n",
        "        f\"# AI3 Project Folder Deliverable\\n\\n\"\n",
        "        f\"Run ID: {RUN_ID}\\n\\n\"\n",
        "        f\"Contains results/, plots/, logs/, weights/, indexes/, notebook/\\n\"\n",
