      "source": [
        "# 5.2 — Compliance Metrics (Numeric + Unit Recall)\n",
        "Since NBCP answers often depend on precise quantitative requirements, compliance-oriented metrics were included"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "V_XrlC3hdS3x",
      "metadata": {
        "id": "V_XrlC3hdS3x"
      },
      "outputs": [],
      "source": [
        "_NUM_RE = re.compile(r\"\\d+(?:\\.\\d+)?\")\n",
        "\n",
        "def extract_numbers_norm(s: str) -> set[str]:\n",
        "    s = _normalize_unicode(str(s)).replace(\",\", \"\")\n",
        "    out = set()\n",
        "    for n in _NUM_RE.findall(s):\n",
        "        try:\n",
        "            out.add(f\"{float(n):.2f}\")  # normalize 2.7 -> 2.70\n",
        "        except:\n",
        "            pass\n",
        "    return out\n",
        "\n",
        "def numeric_recall(pred: str, gold: str) -> float:\n",
        "    p, g = extract_numbers_norm(pred), extract_numbers_norm(gold)\n",
        "    if not g and not p:\n",
        "        return 1.0\n",
        "    if not g:\n",
        "        return 1.0\n",
        "    if not p:\n",
        "        return 0.0\n",
        "    return len(p & g) / len(g)\n",
        "\n",
        "UNIT_PATTERNS = [\n",
        "    r\"\\bmm\\b\", r\"\\bcm\\b\", r\"\\bm\\b\", r\"\\bkm\\b\",\n",
        "    r\"\\bm2\\b\", r\"\\bm3\\b\",\n",
        "    r\"\\bmeters?\\b\", r\"\\bmetres?\\b\", r\"\\bmillimeters?\\b\",\n",
        "    r\"\\bkn\\b\", r\"\\bn\\b\",\n",
        "    r\"\\bkpa\\b\", r\"\\bmpa\\b\", r\"\\bpa\\b\",\n",
        "    r\"\\bpsi\\b\",\n",
        "    r\"\\bdeg\\b\",\n",
        "    r\"%\",\n",
        "]\n",
        "UNIT_RE = re.compile(\"|\".join(UNIT_PATTERNS), flags=re.IGNORECASE)\n",
        "\n",
        "def extract_units(s: str) -> set[str]:\n",
        "    s = _normalize_unicode(str(s).lower())\n",
        "    return {m.lower() for m in UNIT_RE.findall(s)}\n",
        "\n",
        "def unit_recall(pred: str, gold: str) -> float:\n",
        "    p, g = extract_units(pred), extract_units(gold)\n",
        "    if not g and not p:\n",
        "        return 1.0\n",
        "    if not g:\n",
        "        return 1.0\n",
        "    if not p:\n",
        "        return 0.0\n",
        "    return len(p & g) / len(g)"
      ]
    },
