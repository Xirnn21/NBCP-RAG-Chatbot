      ],
      "source": [
        "FAIL_F1_THRESH = 0.30\n",
        "\n",
        "def label_failure(row):\n",
        "    if row[\"recall@k\"] == 0:\n",
        "        return \"Retrieval failure\"\n",
        "    if row[\"token_f1\"] < FAIL_F1_THRESH:\n",
        "        return \"Generation failure\"\n",
        "    return \"OK\"\n",
        "\n",
        "df_all[\"failure_type\"] = df_all.apply(label_failure, axis=1)\n",
        "\n",
        "counts = df_all.groupby([\"model\", \"failure_type\"]).size().unstack(fill_value=0)\n",
        "counts"
      ]
    },
