      "source": [
        "df_all = pd.concat([df_qwen, df_gemma], ignore_index=True)\n",
        "\n",
        "metrics = [\"recall@k\", \"precision@k\", \"token_f1\", \"numeric_recall\", \"unit_recall\"]\n",
        "mean_metrics = df_all.groupby(\"model\")[metrics].mean().reset_index()\n",
        "mean_metrics"
      ]
