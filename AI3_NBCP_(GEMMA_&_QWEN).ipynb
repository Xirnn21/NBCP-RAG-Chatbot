      "source": [
        "def evaluate_model(model_name: str, top_k: int = 20, k_retrieval_eval: int = 5):\n",
        "    rows = []\n",
        "    for i, item in enumerate(test_data):\n",
        "        q = item[\"question\"]\n",
        "        gold = item[\"answer\"]\n",
        "        gold_pages = item.get(\"gold_pages\", [])\n",
        "\n",
        "        out = ask_chatbot(q, model_name=model_name, top_k=top_k)\n",
        "        pred = out[\"answer\"]\n",
        "        retrieved_pages = out[\"pages\"]  # unique sorted pages from your RAG\n",
        "\n",
        "        p_tok, r_tok, f1_tok = token_prf_f1(pred, gold)\n",
        "\n",
        "        rows.append({\n",
        "            \"idx\": i,\n",
        "            \"model\": model_name,\n",
        "            \"question\": q,\n",
        "            \"ground_truth\": gold,\n",
        "            \"prediction\": pred,\n",
        "\n",
        "            # Retrieval metrics\n",
        "            \"recall@k\": recall_at_k(retrieved_pages, gold_pages, k=k_retrieval_eval),\n",
        "            \"precision@k\": precision_at_k(retrieved_pages, gold_pages, k=k_retrieval_eval),\n",
        "\n",
        "            # Generation overlap metrics\n",
        "            \"token_precision\": p_tok,\n",
        "            \"token_recall\": r_tok,\n",
        "            \"token_f1\": f1_tok,\n",
        "\n",
        "            # Compliance metrics\n",
        "            \"numeric_recall\": numeric_recall(pred, gold),\n",
        "            \"unit_recall\": unit_recall(pred, gold),\n",
        "\n",
        "            \"sources\": retrieved_pages,\n",
        "            \"gold_pages\": gold_pages,\n",
        "        })\n",
        "\n",
        "    df = pd.DataFrame(rows)\n",
        "\n",
        "    summary = {\n",
        "        \"model\": model_name,\n",
        "        \"count\": len(df),\n",
        "\n",
        "        # Retrieval\n",
        "        \"recall@k_mean\": float(df[\"recall@k\"].mean()),\n",
        "        \"precision@k_mean\": float(df[\"precision@k\"].mean()),\n",
        "\n",
        "        # Generation (token overlap)\n",
        "        \"token_f1_mean\": float(df[\"token_f1\"].mean()),\n",
        "        \"token_precision_mean\": float(df[\"token_precision\"].mean()),\n",
        "        \"token_recall_mean\": float(df[\"token_recall\"].mean()),\n",
        "\n",
        "        # Compliance\n",
        "        \"numeric_recall_mean\": float(df[\"numeric_recall\"].mean()),\n",
        "        \"unit_recall_mean\": float(df[\"unit_recall\"].mean()),\n",
        "    }\n",
        "\n",
        "    return df, summary\n",
        "\n",
        "\n",
        "# Run evaluation for both\n",
        "df_qwen, sum_qwen = evaluate_model(\"qwen\", top_k=20, k_retrieval_eval=5)\n",
        "df_gemma, sum_gemma = evaluate_model(\"gemma\", top_k=20, k_retrieval_eval=5)\n",
        "\n",
        "pd.DataFrame([sum_qwen, sum_gemma])"
      ]
    },
