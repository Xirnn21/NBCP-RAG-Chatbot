      "source": [
        "EMBED_MODEL_NAME = \"sentence-transformers/all-MiniLM-L6-v2\"\n",
        "embedding_model = SentenceTransformer(EMBED_MODEL_NAME)\n",
        "\n",
        "embeddings = embedding_model.encode(\n",
        "    chunks,\n",
        "    batch_size=32,\n",
        "    show_progress_bar=True,\n",
        "    convert_to_numpy=True,\n",
        "    normalize_embeddings=True,\n",
        ")\n",
        "\n",
        "index = faiss.IndexFlatIP(embeddings.shape[1])  # cosine-like due to normalization\n",
        "index.add(embeddings)\n",
        "print(\"FAISS index size:\", index.ntotal)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "bc31d23c",
      "metadata": {
        "id": "bc31d23c"
      },
      "source": [
        "## 4.3 Retrieval Module (RAG)\n",
        "Retrieve top-k relevant chunks and optionally filter with keyword gating."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "13210e38",
      "metadata": {
        "id": "13210e38"
      },
      "outputs": [],
      "source": [
        "def retrieve_relevant_chunks(query: str, top_k: int = 20):\n",
        "    q_emb = embedding_model.encode([query], convert_to_numpy=True, normalize_embeddings=True)\n",
        "    scores, idxs = index.search(q_emb, top_k)\n",
        "    results = []\n",
        "    for score, idx in zip(scores[0], idxs[0]):\n",
        "        if idx < 0:\n",
        "            continue\n",
        "        results.append({\n",
        "            \"text\": chunks[int(idx)],\n",
        "            \"page\": chunk_meta[int(idx)][\"page\"],\n",
        "            \"score\": float(score),\n",
        "            \"chunk_index\": int(idx),\n",
        "        })\n",
        "    return results\n",
        "\n",
        "def keyword_gate(question: str, contexts: list[dict], keep: int = 4):\n",
        "    q = question.lower()\n",
        "    kws = set(re.findall(r\"[a-z]{4,}|\\d+(?:\\.\\d+)?\", q))\n",
        "    scored = []\n",
        "    for c in contexts:\n",
        "        t = c[\"text\"].lower()\n",
        "        hit = sum(1 for k in kws if k in t)\n",
        "        scored.append((hit, c))\n",
        "    scored.sort(key=lambda x: (x[0], x[1][\"score\"]), reverse=True)\n",
        "    filtered = [c for hit, c in scored if hit > 0]\n",
        "    return (filtered[:keep] if filtered else contexts[:keep])\n"
      ]
    },
