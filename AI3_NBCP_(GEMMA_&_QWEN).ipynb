        "## 4.5 Prompting\n",
        "We enforce grounded, short answers with exact numeric/unit preservation."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "8ffb58fb",
      "metadata": {
        "id": "8ffb58fb"
      },
      "outputs": [],
      "source": [
        "def build_prompt(ctx, question: str, model_name: str):\n",
        "    context_str = \"\\n\\n\".join([f\"[Page {c['page']}] {c['text']}\" for c in ctx])\n",
        "\n",
        "    base_rules = \"\"\"Answer the question using ONLY the provided context.\n",
        "\n",
        "Rules:\n",
        "- Output plain text only.\n",
        "- Give the best supported answer from the context.\n",
        "- Include important numbers, units, limits, dates, or conditions when they are part of the answer.\n",
        "- Use the exact wording from the context when it directly answers the question; otherwise answer briefly in your own words.\n",
        "- Do not add explanations, reasoning steps, or extra dialogue.\n",
        "- Do not use outside knowledge.\n",
        "- If the context contains a partial but relevant answer, provide that partial answer.\n",
        "- Only output exactly: Not specified in the document.\n",
        "  if the context contains no answer at all.\"\"\"\n",
        "\n",
        "    if model_name == \"qwen\":\n",
        "        style_hint = (\n",
        "            \"Prefer a short extractive answer grounded in the context. \"\n",
        "            \"Do not refuse if the answer is stated indirectly or across nearby lines. \"\n",
        "            \"Include the full value with its unit when present.\"\n",
        "        )\n",
        "    elif model_name == \"gemma\":\n",
        "        style_hint = \"Write a natural, complete answer in one or two sentences maximum.\"\n",
        "    else:\n",
        "        style_hint = \"Keep the answer brief and grounded in the context.\"\n",
        "\n",
        "    return f\"\"\"{base_rules}\n",
        "\n",
        "Style:\n",
        "- {style_hint}\n",
        "\n",
        "Context:\n",
        "{context_str}\n",
        "\n",
        "Question: {question}\n",
        "Answer:\"\"\".strip()"
      ]
    },
