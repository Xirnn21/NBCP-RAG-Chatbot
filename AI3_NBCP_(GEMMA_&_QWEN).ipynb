        "        \"recall@k\", \"precision@k\", \"sources\", \"gold_pages\"\n",
        "    ]]\n",
        "\n",
        "print(\"Best Qwen examples:\")\n",
        "display(show_best(df_all, \"qwen\", n=5))\n",
        "\n",
        "print(\"Best Gemma examples:\")\n",
        "display(show_best(df_all, \"gemma\", n=5))\n"
      ]
