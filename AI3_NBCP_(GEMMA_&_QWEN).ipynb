      "outputs": [],
      "source": [
        "def recall_at_k(retrieved_pages: list[int], gold_pages: list[int], k: int) -> float:\n",
        "    \"\"\"\n",
        "    Recall@K = 1 if any gold page appears in top-K retrieved pages, else 0.\n",
        "    \"\"\"\n",
        "    if not gold_pages:\n",
        "        return 0.0\n",
        "    topk = retrieved_pages[:k]\n",
        "    return float(len(set(topk) & set(gold_pages)) > 0)\n",
        "\n",
        "def precision_at_k(retrieved_pages: list[int], gold_pages: list[int], k: int) -> float:\n",
        "    \"\"\"\n",
        "    Precision@K = (# of top-K pages that are gold) / K\n",
        "    \"\"\"\n",
        "    if not gold_pages or k <= 0:\n",
        "        return 0.0\n",
        "    topk = retrieved_pages[:k]\n",
        "    return len(set(topk) & set(gold_pages)) / k"
      ]
    },
